# Quote values containing $ with single quotes: docker compose expands $ in this file.

# ===================
# Secret Keys
# ===================
# Generate each with: openssl rand -hex 32
# Images built from this version or later auto-generate empty keys and persist them in
# instance/ (keep it private); older images refuse logins without keys.
SECRET_KEY=
JWT_SECRET_KEY=

# ===================
# Required Settings
# ===================
# OpenTAK Server Connection
OTS_USERNAME=administrator
OTS_PASSWORD=password
OTS_URL=https://host.docker.internal
OTS_VERIFY_SSL=False

# ===================
# Application
# ===================
DEBUG=False
SQLALCHEMY_DATABASE_URI=sqlite:///db.sqlite
# Required: set to the portal's public URL; at localhost, emailed links won't work for recipients
FRONTEND_URL=http://localhost:5000
CORS_ORIGINS=*
# Container timezone (defaults to UTC); see docs/DOCKER.md before changing it later
# TZ=Europe/Amsterdam

# ===================
# Email (Optional)
# ===================
MAIL_ENABLED=False
MAIL_SERVER=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=username
MAIL_PASSWORD=password
MAIL_USE_TLS=False
MAIL_USE_SSL=True
MAIL_DEFAULT_SENDER=no-reply@example.com

# ===================
# Storage Paths
# ===================
DATAPACKAGE_UPLOAD_FOLDER=datapackages
UPDATES_UPLOAD_FOLDER=updates
