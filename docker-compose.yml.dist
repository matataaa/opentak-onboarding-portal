services:
    web:
        restart: always
        image: mattronix/atak-onboarding-portal
        # Uncomment below to build locally instead of using Docker Hub
        # build:
        #     context: .
        #     dockerfile: Dockerfile
        #     args:
        #         GIT_COMMIT: ${GIT_COMMIT:-dev}
        #         GIT_DATE: ${GIT_DATE:-unknown}
        ports:
            - "5000:5000"
        env_file:
            - .env
        volumes:
            # Mount database for persistence
            - ./instance:/app/instance
            # Mount data packages
            - ./datapackages:/app/datapackages
        environment:
            # Set FRONTEND_URL to the portal's public URL, here or in .env. At its localhost default,
            # links in emails and event QR codes point at localhost and won't work for recipients.
            # - FRONTEND_URL=https://your-domain.com
            - CORS_ORIGINS=*
        extra_hosts:
            - "host.docker.internal:host-gateway"